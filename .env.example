# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# The only Google account allowed to sign in as the freelancer.
ALLOWED_EMAIL=you@gmail.com

# Telegram bot token from @BotFather (Phase 2). Optional: without it, the Telegram option is hidden.
TELEGRAM_BOT_TOKEN=

# Email through your Gmail (Phase 3). App Password: Google Account → Security → 2-Step
# Verification → App passwords. Optional: without these, the email option is hidden.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Any long random string. The Supabase timer sends it to /api/cron/email.
CRON_SECRET=
